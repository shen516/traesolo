# 生产环境变量示例（复制为服务器上的 .env，勿提交真实值）
# docker compose --env-file .env up -d

# —— 必填（生产）——
TRAESOLO_PRODUCTION=1
ADMIN_PASSWORD=change-me-strong-password

# —— 数据库 / 缓存 ——
# DATABASE_URL 也可在 compose 中写死内网地址；裸机部署时用本变量覆盖
# DATABASE_URL=mysql+pymysql://football:SECRET@mysql:3306/football_analytics
# REDIS_URL=redis://redis:6379/0

# —— 运行开关 ——
RUN_SCHEDULER=1
TRAESOLO_INITIAL_CRAWL=0
TRAESOLO_JSON_LOGS=1
# TRAESOLO_CORS_ORIGINS=https://your.domain

# —— 前端构建（可选）——
# VITE_API_BASE_URL=/api/v1
