# 生产环境变量示例（复制为服务器上的 .env，勿提交真实值）
#
# 宿主机 MySQL/MariaDB + Redis + 后端 Docker host 网络（推荐线上）：
#   cp .env.production.example .env && chmod 600 .env
#   # 编辑 .env 后：
#   docker compose -f docker-compose.host.yml --env-file .env up -d --build
#
# 全容器（含 MySQL）：
#   docker compose --profile bundled-db --env-file .env up -d --build

# —— 必填（生产）——
# TRAESOLO_PRODUCTION=1 时，ADMIN_PASSWORD 必须非默认弱口令 admin123
# Compose 会把它映射为容器内 TRAESOLO_ADMIN_PASSWORD
TRAESOLO_PRODUCTION=1
ADMIN_PASSWORD=change-me-strong-password

# —— 数据库 / 缓存（配合 docker-compose.host.yml 的 network_mode: host）——
# MariaDB/MySQL 只监听 127.0.0.1 时，主机必须用 127.0.0.1（不要用 host.docker.internal）
# 库名、账号、端口按线上实际修改（示例库名 football；勿照搬 football_analytics）
# 密码含特殊字符时 URL 编码（@ → %40，! → %21 等）
DATABASE_URL=mysql+pymysql://football:YOUR_PASSWORD@127.0.0.1:3306/football

# 宿主机 Redis（与以前裸机相同）
REDIS_URL=redis://127.0.0.1:6379/0

# —— 运行开关 ——
RUN_SCHEDULER=1
TRAESOLO_INITIAL_CRAWL=0
TRAESOLO_JSON_LOGS=1
# TRAESOLO_CORS_ORIGINS=https://your.domain

# —— 前端构建（可选）——
# VITE_API_BASE_URL=/api/v1
