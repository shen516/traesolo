# 生产环境变量示例（复制为服务器上的 .env，勿提交真实值）
#
# 宿主机 MySQL + 后端代码挂载（推荐线上）：
#   docker compose -f docker-compose.host.yml --env-file .env up -d --build
#
# 全容器（含 MySQL）：
#   docker compose --profile bundled-db --env-file .env up -d --build

# —— 必填（生产）——
TRAESOLO_PRODUCTION=1
ADMIN_PASSWORD=change-me-strong-password

# —— 数据库 / 缓存（配合 docker-compose.host.yml 的 network_mode: host）——
# MariaDB 只监听 127.0.0.1 时，必须用 127.0.0.1（不要用 host.docker.internal）
# 端口、库名、账号按线上实际修改；密码含特殊字符时 URL 编码（如 @ → %40）
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/football_analytics

# 宿主机 Redis（与以前裸机相同）
REDIS_URL=redis://127.0.0.1:6379/0

# —— 运行开关 ——
RUN_SCHEDULER=1
TRAESOLO_INITIAL_CRAWL=0
TRAESOLO_JSON_LOGS=1
# TRAESOLO_CORS_ORIGINS=https://your.domain

# —— 前端构建（可选）——
# VITE_API_BASE_URL=/api/v1
